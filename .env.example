# ==============================================================================
# TCT AnsiblePulse Environment Configuration
# Production & Local WSL Docker Database Settings
# ==============================================================================

# Database Connection URL (Tuned for local WSL Docker mapping on port 5435)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5436/ansible_pulse

# PostgreSQL Container Configuration
POSTGRES_PORT=5436
POSTGRES_DB=ansible_pulse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Production Connection Pool Tuning
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=25
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Application Port
PORT=8000
HOST=127.0.0.1
