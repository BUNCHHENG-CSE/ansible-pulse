# ==============================================================================
# Ansible Pulse - Project .gitignore
# Observability Layer for Fragmented Ansible IaC Scripts
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# ------------------------------------------------------------------------------
# 2. Next.js & Frontend Build Outputs
# ------------------------------------------------------------------------------
.next/
out/
dist/
dist-ssr/
frontend/dist/
.turbo/
*.tsbuildinfo
next-env.d.ts.bak

# ------------------------------------------------------------------------------
# 3. Python Runtime, Bytecode & Virtual Environments
# ------------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# ------------------------------------------------------------------------------
# 4. Testing, Linting & Coverage
# ------------------------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage/
.hypothesis/

# ------------------------------------------------------------------------------
# 5. Databases & Local Persistent State
# ------------------------------------------------------------------------------
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
ansible_pulse.db
prisma/ansible_pulse.db
*.dump
*.sql.gz

# ------------------------------------------------------------------------------
# 6. Environment Configurations & Secrets
# ------------------------------------------------------------------------------
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
# Explicitly keep example environment configuration tracked:
!.env.example

# ------------------------------------------------------------------------------
# 7. Ansible & Demo Fixtures (Generated Workspace Artifacts)
# ------------------------------------------------------------------------------
# Dynamically generated enterprise repos containing nested .git directories:
demo_repos/
# Canonical roles generated by `cli.py remediate`:
canonical_roles/
# Ansible playbook failure retry files:
*.retry
.ansible/

# ------------------------------------------------------------------------------
# 8. Generated Audit & Governance Reports
# ------------------------------------------------------------------------------
audit_report.md
audit_report.html
*.report.json
*.report.html

# ------------------------------------------------------------------------------
# 9. Logs
# ------------------------------------------------------------------------------
*.log
logs/

# ------------------------------------------------------------------------------
# 10. Operating System Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
ehthumbs_vista.db
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------------------------
# 11. IDEs & Code Editors
# ------------------------------------------------------------------------------
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
